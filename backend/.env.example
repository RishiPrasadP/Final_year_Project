APP_NAME=LIL Backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=lil

