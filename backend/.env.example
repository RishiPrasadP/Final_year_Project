OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=30
OTP_MOCK_MODE=true

OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=mock

STORAGE_PROVIDER=gridfs

RAZORPAY_KEY_ID=
